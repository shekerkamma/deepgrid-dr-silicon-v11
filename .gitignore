/public/ort/

# graphify per-run cache and scratch (rebuilt from source every run; LLM extraction outputs stay tracked)
/graphify-out/cache/
/graphify-out/.graphify_root
/graphify-out/.graphify_python
/graphify-out/.graphify_detect.json
/graphify-out/.graphify_ast.json
/graphify-out/.graphify_labels.json.sig
/public/vendor/
*.tmp
verify-shots/
/.v6-serve/
/.npm-cache/

# Playwright MCP screenshots from review sessions
/.playwright-mcp/
__pycache__/
qa/

/.impeccable/review/
/services/ask/work/
# business-plan dashboard: generated per build (scripts/build-plan-data.mjs); never committed
/app/plan-data.json
/public/plan-data/
# SKU portfolio dashboard: generated per build (scripts/build-portfolio-data.mjs); never committed
/app/portfolio-data.json
/public/portfolio-data/

# Animation pieces (pieces/<name>/): commit the source, brief, log and approval boards; frames, renders and review sheets regenerate.
pieces/*/frames/
pieces/*/renders/
pieces/*/review/
pieces/*/check.png
pieces/*/end.png
# Reference media for animate styles (new-style.md): local only, never committed.
references/
