<mxfile host="drawio" version="26.0.0"><diagram name="SKU-5 architecture"><mxGraphModel dx="1560" dy="724" grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="724" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="SKU-5 interface transceiver system architecture" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Two line drivers on one die, an RS-485 channel and a CAN-FD channel, each with its own logic interface, protection, supply and clock" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1480" height="24" as="geometry"/></mxCell><mxCell id="c27" value="SKU-5  ·  130 nm with 5 V thick-oxide LDMOS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBFCFE;strokeColor=#0A1628;strokeWidth=2;dashed=1;verticalAlign=top;align=right;spacingRight=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#0A1628;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1480" height="526" as="geometry"/></mxCell><mxCell id="c4" value="Channel 1 · RS-485  ·  half duplex · up to 256 nodes · −7 to +12 V CM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FE;strokeColor=#8DB4D4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="60" y="118" width="614" height="470" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Logic IF&lt;/b&gt;&lt;br&gt;1.8 V core · level shift to 5 V · TXD · RXD · EN/STB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="72" y="152" width="190" height="135" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Pre-driver&lt;/b&gt;&lt;br&gt;slew shaping · dV/dt 3 V/ns trimmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="272" y="152" width="190" height="135" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Output stage&lt;/b&gt;&lt;br&gt;diff push-pull · thick-oxide 5 V LDMOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="472" y="152" width="190" height="135" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Prot logic&lt;/b&gt;&lt;br&gt;EN interlock · no bus contention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="72" y="297" width="190" height="135" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Fault&lt;/b&gt;&lt;br&gt;thermal + short · 150 °C shutdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="272" y="297" width="190" height="135" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Receiver&lt;/b&gt;&lt;br&gt;hysteresis comp · 30 mV hyst · 50 ns prop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="472" y="297" width="190" height="135" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Failsafe bias&lt;/b&gt;&lt;br&gt;idle = recessive · open / short / idle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="72" y="441" width="190" height="135" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;ESD + 