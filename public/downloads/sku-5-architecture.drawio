0 MHz · bit-time recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="898" y="152" width="190" height="135" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;ESD + EMC&lt;/b&gt;&lt;br&gt;±15 kV, rated per test standard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1098" y="152" width="190" height="135" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Failsafe bias&lt;/b&gt;&lt;br&gt;idle = recessive · open / short / idle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1298" y="152" width="190" height="135" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Output stage&lt;/b&gt;&lt;br&gt;diff push-pull · thick-oxide 5 V LDMOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="898" y="297" width="190" height="135" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Pre-driver&lt;/b&gt;&lt;br&gt;slew shaping · dV/dt 3 V/ns trimmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1098" y="297" width="190" height="135" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Logic IF&lt;/b&gt;&lt;br&gt;1.8 V core · level shift to 5 V · TXD · RXD · EN/STB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1298" y="297" width="190" height="135" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Receiver&lt;/b&gt;&lt;br&gt;hysteresis comp · 30 mV hyst · 50 ns prop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="898" y="441" width="190" height="135" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Fault&lt;/b&gt;&lt;br&gt;thermal + short · 150 °C shutdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1098" y="441" width="190" height="135" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Prot logic&lt;/b&gt;&lt;br&gt;TXD timeout · bus-fault detect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1298" y="441" width="190" height="135" as="geometry"/></mxCell><mxCell id="c28" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0A1628;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#0A1628;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B54708;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B54708;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B42318;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B8DB8;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#5B8DB8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0A1628;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#0A1628;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B54708;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B54708;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B42318;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c21" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B8DB8;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#5B8DB8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Reading path&lt;/b&gt;   ①  TXD enters the logic interface and is level-shifted to 5 V.   ②  The pre-driver shapes the edge for the output stage.   ③  The differential output drives the bus pins.   ④  The receiver reads the bus back to RXD. Channel 2 follows the same path.   ·   dashed boxes are off-chip   ·   pre-silicon architecture; values are design targets" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1480" height="58" as="geometry"/></mxCell><mxCell id="c37" value="Designed toward (targets, not certificates): TIA/EIA-485, ISO 11898-2, IEC 61000-4-2 (system level) and HBM (component level), each rated separately" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6B7280;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1480" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
