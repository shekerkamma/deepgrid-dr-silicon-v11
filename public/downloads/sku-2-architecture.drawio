Color=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="72" y="204" width="172" height="124" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;DECIM&lt;/b&gt;&lt;br&gt;sinc³ · OSR 256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="254" y="204" width="172" height="124" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;METRO&lt;/b&gt;&lt;br&gt;P Q S · THD-15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="436" y="204" width="172" height="124" as="geometry"/></mxCell><mxCell id="c9" value="Compute + security" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FE;strokeColor=#8DB4D4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="640" y="170" width="560" height="170" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;DGridRiscV&lt;/b&gt;&lt;br&gt;RV32IM_Zicsr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="652" y="204" width="172" height="124" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;DMA&lt;/b&gt;&lt;br&gt;4-ch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="834" y="204" width="172" height="124" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;DG-SE&lt;/b&gt;&lt;br&gt;AES-256 · SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1016" y="204" width="172" height="124" as="geometry"/></mxCell><mxCell id="c13" value="Always-on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#B54708;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1220" y="170" width="280" height="170" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;PMU + RTC&lt;/b&gt;&lt;br&gt;32.768 kHz XTAL · brownout 2.0 V · &amp;lt;2 µW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B54708;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1232" y="204" width="256" height="124" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;AHB-Lite multilayer  ·  32-bit  ·  4 masters / 9 slaves  ·  100 MHz&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0A1628;strokeColor=#0A1628;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="368" width="1440" height="38" as="geometry"/></mxCell><mxCell id="c16" value="Peripherals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#6B7280;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="60" y="434" width="1440" height="120" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;RTC&lt;/b&gt;&lt;br&gt;tamper log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="72" y="468" width="228" height="74" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Timer&lt;/b&gt;&lt;br&gt;capture / compare" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="310" y="468" width="228" height="74" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;LCD&lt;/b&gt;&lt;br&gt;4 × 40 seg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="547" y="468" width="228" height="74" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;UART&lt;/b&gt;&lt;br&gt;DLMS / COSEM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="785" y="468" width="228" height="74" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Tamper&lt;/b&gt;&lt;br&gt;case · magnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1023" y="468" width="228" height="74" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;GPIO&lt;/b&gt;&lt;br&gt;relay + LED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1260" y="468" width="228" height="74" as="geometry"/></mxCell><mxCell id="c24" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#067647;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#067647;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#067647;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#067647;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#067647;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#067647;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B8DB8;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#5B8DB8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0A1628;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#0A1628;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Reading path&lt;/b&gt;   ①  Six voltage and current channels enter the front end.   ②  The 24-bit samples decimate through sinc³ at OSR 256.   ③  The metrology engine computes P, Q, S and THD.   ④  Results cross the 32-bit bus to the core and DMA.   ⑤  Readings leave on the DLMS/COSEM UART.   ·   dashed boxes are off-chip   ·   pre-silicon architecture; values are design targets" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="40" y="586" width="1480" height="58" as="geometry"/></mxCell><mxCell id="c30" value="Designed toward (targets, not certificates): IEC metering accuracy Class 0.5S" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6B7280;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="656" width="1480" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
