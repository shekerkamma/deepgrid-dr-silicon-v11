<mxfile host="drawio" version="26.0.0"><diagram name="SKU-1 architecture"><mxGraphModel dx="1560" dy="876" grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="876" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="SKU-1 BLDC motor controller system architecture" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Host control plane, mixed signal and power path on one AXI bus; a hardware field-oriented-control datapath closes the current loop · from Technical Annex v3, sheet 2" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1480" height="24" as="geometry"/></mxCell><mxCell id="c33" value="SKU-1  ·  130 nm BCD / high-voltage CMOS  ·  100 MHz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBFCFE;strokeColor=#0A1628;strokeWidth=2;dashed=1;verticalAlign=top;align=right;spacingRight=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#0A1628;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1480" height="570" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Speed (rpm) · torque · halt · brake · ramp up / down   (host commands)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#6B7280;dashed=1;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="60" y="78" width="520" height="36" as="geometry"/></mxCell><mxCell id="c5" value="Host · control plane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FE;strokeColor=#8DB4D4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="481" height="250" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;DGridRiscV&lt;/b&