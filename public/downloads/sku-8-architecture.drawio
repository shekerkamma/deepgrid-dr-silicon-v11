etry"/></mxCell><mxCell id="c39" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B42318;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B54708;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B54708;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c14" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0A1628;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#0A1628;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c20" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Reading path&lt;/b&gt;   ①  Video arrives over LVDS, MIPI DSI or parallel RGB.   ②  The line buffer feeds the pixel pipeline, 24 bits per pixel.   ③  Dithered pixels drive the column DACs.   ④  High-voltage amplifiers drive the 3,840 column outputs.   ⑤  The timing controller scans the rows through the gate driver.   ·   dashed boxes are off-chip   ·   pre-silicon architecture; values are design targets" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="40" y="808" width="1480" height="58" as="geometry"/></mxCell><mxCell id="c43" value="Designed toward (targets, not certificates): ISO 26262 ASIL-B, MIL-STD-810G, DEF-STAN 00-35" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6B7280;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="878" width="1480" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
