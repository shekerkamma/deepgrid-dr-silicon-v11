86" y="301" width="202" height="87" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Control bus  ·  SPI / I²C register file  ·  200 MHz&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0A1628;strokeColor=#0A1628;fontSize=14;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="428" width="1440" height="38" as="geometry"/></mxCell><mxCell id="c20" value="Column (source) drivers · high-voltage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3F2;strokeColor=#B42318;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="60" y="494" width="874" height="230" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;DAC bank&lt;/b&gt;&lt;br&gt;10-bit, 1 per column · resistor-string + buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B42318;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="72" y="528" width="277" height="184" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Output amps&lt;/b&gt;&lt;br&gt;rail-to-rail HV · 0 to 12 V swing, thick oxide" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B42318;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="359" y="528" width="277" height="184" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Column outputs × 1280&lt;/b&gt;&lt;br&gt;3 sub-pixels × 1280 → 3,840 outputs · charge-sharing precharge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B42318;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="645" y="528" width="277" height="184" as="geometry"/></mxCell><mxCell id="c24" value="Row + backlight" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#067647;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="954" y="494" width="546" height="230" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Gate driver IF&lt;/b&gt;&lt;br&gt;row scan · up to 24 V level shift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="966" y="528" width="256" height="87" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;VCOM&lt;/b&gt;&lt;br&gt;common electrode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1232" y="528" width="256" height="87" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Backlight&lt;/b&gt;&lt;br&gt;PWM + LED string · local dimming, 8 zones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="966" y="625" width="256" height="87" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Ambient&lt;/b&gt;&lt;br&gt;light + temp sense" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1232" y="625" width="256" height="87" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;To the panel · source / gate / VCOM / LED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#6B7280;dashed=1;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="960" y="756" width="540" height="36" as="geometry"/></mxCell><mxCell id="c31" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#067647;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#067647;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style=