Geometry x="1052" y="525" width="148" height="70" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;PMU&lt;/b&gt;&lt;br&gt;5 domains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1214" y="525" width="148" height="70" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;SEC&lt;/b&gt;&lt;br&gt;secure boot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1376" y="525" width="148" height="70" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;ETH / USB3&lt;/b&gt;&lt;br&gt;payload + ground link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="890" y="625" width="200" height="70" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;CAN-FD × 2 · SPI · I²C&lt;/b&gt;&lt;br&gt;gimbal, payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1105" y="625" width="250" height="70" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;JTAG&lt;/b&gt;&lt;br&gt;debug" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8DB4D4;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1370" y="625" width="150" height="70" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;PROTOTYPE&lt;/b&gt;  Artix-7 FPGA · 81.25 MHz · validation only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#6B7280;dashed=1;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="270" y="815" width="520" height="44" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;PRODUCT&lt;/b&gt;  28 nm S