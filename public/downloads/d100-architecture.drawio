<mxfile host="drawio" version="26.0.0"><diagram name="D100 architecture"><mxGraphModel dx="1600" dy="940" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="940" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="D100 drone SoC system architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="36" as="geometry"/></mxCell><mxCell id="c3" value="One 28 nm chip  ·  flight control, visual-inertial odometry and a hardware failsafe island  ·  NPU in variant 2 only  ·  pre-silicon architecture from the SKU Blueprint, October 2026" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c4" value="D100  ·  28 nm SoC  ·  failsafe island buildable at 130 nm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FE;strokeColor=#0A1628;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#0A1628;" vertex="1" parent="1"><mxGeometry x="270" y="125" width="1290" height="665" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Cameras&lt;/b&gt;&lt;br&gt;external" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#6B7280;dashed=1;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="720" y="74" width="200" height="40" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;IMU · magnetometer · barometer&lt;/b&gt;&lt;br&gt;external" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#6B7280;dashed=1;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="200" height="54" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;RC receiver, telemetry radio&lt;/b&gt;&lt;br&gt;external" style="rounded=1;whiteSpace=wrap;