chdog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3F2;strokeColor=#B42318;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="908" y="526" width="592" height="170" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Window logic&lt;/b&gt;&lt;br&gt;open + close · 100 ms to 1.6 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B42318;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="920" y="560" width="183" height="124" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;WDI&lt;/b&gt;&lt;br&gt;kick input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B42318;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1113" y="560" width="183" height="124" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Timeout&lt;/b&gt;&lt;br&gt;counter → RESET_N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B42318;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1305" y="560" width="183" height="124" as="geometry"/></mxCell><mxCell id="c36" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B8DB8;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#5B8DB8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B8DB8;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#5B8DB8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B8DB8;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#5B8DB8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B8DB8;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#5B8DB8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6941C6;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#6941C6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#067647;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#067647;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.62;entryY=1;" edge="1" parent="1" source="c27" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B42318;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B42318;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c34" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Reading path&lt;/b&gt;   ①  Each rail enters through its divider.   ②  The comparator and deglitch counter report a confirmed fault to the matrix.   ③  The matrix latches it and drives FAULT_N, then RESET_N.   ④  The trimmed bandgap sets every comparator threshold.   ⑤  A missed or early watchdog kick times out to RESET_N.   ·   dashed boxes are off-chip   ·   pre-silicon architecture; values are design targets" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="1480" height="58" as="geometry"/></mxCell><mxCell id="c45" value="Designed toward (targets, not certificates): MIL-STD-883K Class B screening flow" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6B7280;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="798" width="1480" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
