<mxfile host="drawio" version="26.0.0"><diagram name="SKU-9 architecture"><mxGraphModel dx="1560" dy="874" grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="874" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="SKU-9 zonal controller and gateway system architecture" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#1E293B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c3" value="A lockstep safety island, a security module and real-time control on a 64-bit AXI4 crossbar, bridging in-vehicle networks to sixteen smart fuses · from Technical Annex v3, sheet 10" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1480" height="24" as="geometry"/></mxCell><mxCell id="c29" value="SKU-9  ·  130 nm CMOS and BCD  ·  100 MHz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBFCFE;strokeColor=#0A1628;strokeWidth=2;dashed=1;verticalAlign=top;align=right;spacingRight=14;spacingTop=6;fontSize=15;fontStyle=1;fontColor=#0A1628;" vertex="1" parent="1"><mxGeometry x="40" y="132" width="1480" height="570" as="geometry"/></mxCell><mxCell id="c4" value="Scope, as the sheet states it: 130 nm at 100 MHz owns the zonal layer: gateway, smart I/O, safety and security edge. Central software-defined-vehicle compute is a sub-10 nm part and is not claimed here." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#B54708;align=left;spacingLeft=12;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1480" height="40" as="geometry"/></mxCell><mxCell id="c5" value="Safety island" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3F2;strokeColor=#B42318;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="60" y="172" width="467" height="230" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;DGridRiscV × 2&lt;/b&gt;&lt;br&gt;RV32IM_Zicsr · lockstep · 100 MHz · +2 cycle skew · PMP · ECC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B42318;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="72" y="206" width="216" height="87" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Comparator&lt;/b&gt;&lt;br&gt;bus + retire · mismatch → safe state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B42318;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="298" y="206" width="216" height="87" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Freedom from interference&lt;/b&gt;&lt;br&gt;MPU + bus firewall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B42318;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="72" y="303" width="443" height="87" as="geometry"/></mxCell><mxCell id="c9" value="Security" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F3FF;strokeColor=#6941C6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="547" y="172" width="467" height="230" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;HSM&lt;/b&gt;&lt;br&gt;hardware security module · AES-256 · ECC-256 · true RNG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6941C6;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="559" y="206" width="216" height="87" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Secure boot&lt;/b&gt;&lt;br&gt;root of trust · OTP key store · A/B slots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6941C6;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex=