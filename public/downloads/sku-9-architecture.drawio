"c18" value="In-vehicle network · gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#067647;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="60" y="496" width="852" height="190" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;100BASE-T1 × 2&lt;/b&gt;&lt;br&gt;automotive Ethernet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="72" y="530" width="269" height="67" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;CAN-FD × 8&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="351" y="530" width="269" height="67" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;CAN-XL × 1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="631" y="530" width="269" height="67" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;LIN × 8&lt;/b&gt;&lt;br&gt;masters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="72" y="607" width="269" height="67" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;FlexRay × 1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#067647;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="351" y="607" width="269" height="67" as="geometry"/></mxCell><mxCell id="c24" value="Zonal power + I/O" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#B54708;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="932" y="496" width="568" height="190" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Smart fuse × 16&lt;/b&gt;&lt;br&gt;eFuse + sense · replaces relay box" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B54708;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="944" y="530" width="267" height="67" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;HS driver × 8&lt;/b&gt;&lt;br&gt;load control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B54708;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1221" y="530" width="267" height="67" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;ADC 12-bit&lt;/b&gt;&lt;br&gt;24-ch sense" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B54708;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="944" y="607" width="267" height="67" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;PWM × 12&lt;/b&gt;&lt;br&gt;actuator drive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B54708;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1221" y="607" width="267" height="67" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;To the zone harness · loads, sensors, actuators&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#6B7280;dashed=1;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="960" y="718" width="540" height="36" as="geometry"/></mxCell><mxCell id="c31" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#067647;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#067647;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B8DB8;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#5B8DB8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B8DB8;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#5B8DB8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B54708;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B54708;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B54708;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B54708;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B42318;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Reading path&lt;/b&gt;   ①  Messages arrive on Ethernet, CAN and LIN.   ②  The TSN switch schedules them against precision time.   ③  The service router forwards them across the crossbar.   ④  They become switched power at the smart fuses.   ⑤  A lockstep mismatch drives the safe state.   ·   dashed boxes are off-chip   ·   pre-silicon architecture; values are design targets" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1480" height="58" as="geometry"/></mxCell><mxCell id="c38" value="Designed toward (targets, not certificates): ISO 26262 ASIL-D, EVITA Full, AUTOSAR Classic 4.4, AEC-Q100 Grade 1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6B7280;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1480" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
