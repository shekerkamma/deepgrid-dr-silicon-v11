constant false-alarm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6941C6;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1221" y="390" width="267" height="77" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Target list&lt;/b&gt;&lt;br&gt;range · velocity · angle · RCS · up to 64 tracks per frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6941C6;strokeWidth=2;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="944" y="477" width="544" height="77" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;To the ECU · CAN-FD · 100BASE-T1 · MIPI CSI-2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#6B7280;dashed=1;fontSize=12;fontColor=#1E293B;arcSize=6;" vertex="1" parent="1"><mxGeometry x="960" y="598" width="540" height="36" as="geometry"/></mxCell><mxCell id="c29" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B54708;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B54708;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B54708;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B54708;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B54708;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B54708;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B54708;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B54708;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B42318;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B42318;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B42318;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="LO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6941C6;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#6941C6;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c11" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="③" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B8DB8;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#5B8DB8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B8DB8;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#5B8DB8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B8DB8;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#5B8DB8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B54708;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#B54708;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c22" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#067647;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#067647;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#067647;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#067647;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#067647;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#067647;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#067647;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#067647;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6941C6;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#6941C6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6941C6;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#6941C6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c25" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="⑥" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0A1628;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#0A1628;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c26" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Reading path&lt;/b&gt;   ①  The crystal, ramp generator, PLL and VCO synthesise the chirp.   ②  The doubler reaches 77 GHz and the two PAs transmit.   ③  Each of four echoes is amplified, mixed with the LO, filtered.   ④  The IF signals cross the die boundary and four 12-bit converters digitise them for the range FFT.   ⑤  The range-Doppler map feeds CFAR detection and angle estimation.   ⑥  The target list goes to the ECU over CAN-FD, 100BASE-T1 or MIPI CSI-2.   ·   dashed boxes are off-chip   ·   pre-silicon architecture; values are design targets" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1480" height="58" as="geometry"/></mxCell><mxCell id="c48" value="Designed toward (targets, not certificates): ISO 26262 ASIL-B, DO-160G, MIL-STD-883K" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#6B7280;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="1480" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
